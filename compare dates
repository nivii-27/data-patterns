#include <stdio.h>

struct Date {
    int day;
    int month;
    int year;
};

int compareDates(struct Date d1, struct Date d2) {
    if (d1.year > d2.year || 
       (d1.year == d2.year && d1.month > d2.month) || 
       (d1.year == d2.year && d1.month == d2.month && d1.day > d2.day)) {
        struct Date temp = d1;
        d1 = d2;
        d2 = temp;
    }

    int months_diff = (d2.year - d1.year) * 12 + (d2.month - d1.month);

    if (months_diff == 0) {
        return -1; 
    } else if (months_diff == 1) {
        if (d2.day == d1.day) {
            return 0; 
        } else if (d2.day < d1.day) {
            return -1; 
        } else {
            return 1; 
        }
    } else {
        return 1; 
    }
}

void checkApart(struct Date d1, struct Date d2) {
    int result = compareDates(d1, d2);
    if (result == 0) {
        printf("Exactly 1 month apart\n");
    } else if (result == -1) {
        printf("Less than 1 month apart\n");
    } else {
        printf("More than 1 month apart\n");
    }
}

int main() {
    struct Date date1 = {6, 6, 2011};
    struct Date date2 = {6, 7, 2011};
    checkApart(date1, date2);

    struct Date date3 = {15, 12, 2010};
    struct Date date4 = {15, 1, 2011};
    checkApart(date3, date4);

    struct Date date5 = {1, 3, 2011};
    struct Date date6 = {25, 3, 2011};
    checkApart(date5, date6);

    return 0;
}
